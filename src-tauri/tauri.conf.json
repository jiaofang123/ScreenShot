{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenShot",
  "version": "0.1.0",
  "identifier": "com.amamda.screenshot",
  "build": {
    "beforeDevCommand": "npm run media:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run media:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenShot",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/studio/": "studio/"
    },
    "shortDescription": "截图、录屏与视频旁白制作",
    "longDescription": "桌面截图与演示视频制作工具，支持截图标注、滚动长截图、原生窗口与区域录屏、视频文字稿、中文旁白、音视频合成和批量合并导出。",
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
